# Настройки службы mssql-backup. После изменения: sudo systemctl restart mssql-backup
# Значения с пробелами и спецсимволами берите в одинарные кавычки: MSSQL_PASSWORD='p@ss word'

# --- Подключение к SQL Server ---
MSSQL_HOST=sql.example.com
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD='CHANGE_ME'

# --- Локальный администратор веб-интерфейса (полный доступ) ---
# Входит всегда, даже если LDAP настроен неверно. Не используйте это имя для пользователей LDAP.
ADMIN_USER=admin
ADMIN_PASSWORD='__ADMIN_PASSWORD__'

# true — если страница открыта по HTTPS (cookie сессии получает флаг Secure)
COOKIE_SECURE=false

# --- Необязательно ---
# Папка по умолчанию для типа хранилища «папка на сервере SQL Server» (меняется в «Настройках»)
# MSSQL_BACKUP_DIR=/var/opt/mssql/backup
# CA-сертификат для LDAPS/StartTLS, если сервер LDAP использует внутренний центр сертификации
# LDAP_CA_FILE=/etc/mssql-backup/ldap-ca.pem
# Сколько дней хранить историю действий
# HISTORY_KEEP_DAYS=365
